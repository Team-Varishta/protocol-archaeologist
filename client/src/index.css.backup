:root {
  --bg: #0a0a0a;
  --text: #e0e0e0;
  --text-h: #ffffff;
  --border: #2a2a2a;
  --code-bg: #1a1a1a;
  --accent: #8a6dff;
  --accent-bg: rgba(138, 109, 255, 0.1);
  --accent-border: rgba(138, 109, 255, 0.3);
  --success: #4ade80;
  --warning: #fbbf24;
  --error: #f87171;
  --shadow: 0 4px 6px -1px rgba(0,0,0,0.3), 0 2px 4px -1px rgba(0,0,0,0.1);

  --sans: system-ui, 'Segoe UI', Roboto, sans-serif;
  --heading: system-ui, 'Segoe UI', Roboto, sans-serif;
  --mono: ui-monospace, Consolas, monospace;

  font: 18px/145% var(--sans);
  letter-spacing: 0.18px;
  color-scheme: dark;
  color: var(--text);
  background: var(--bg);
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

@media (max-width: 1024px) {
  font-size: 16px;
}

/* Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

#root {
  width: 1126px;
  max-width: 100%;
  margin: 0 auto;
  text-align: center;
  border-inline: 1px solid var(--border);
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

body {
  margin: 0;
}

h1,
h2 {
  font-family: var(--heading);
  font-weight: 500;
  color: var(--text-h);
}

h1 {
  font-size: 56px;
  letter-spacing: -1.68px;
  margin: 32px 0;
}

h2 {
  font-size: 24px;
  line-height: 118%;
  letter-spacing: -0.24px;
  margin: 0 0 8px;
}

p {
  margin: 0;
}

/* Layout */
.app-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.app-header {
  text-align: center;
  padding: 24px 0;
  border-bottom: 1px solid var(--border);
}

.app-subtitle {
  color: var(--text);
  margin-top: 8px;
  font-size: 18px;
}

.investigation-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 24px;
}

.hero-description {
  color: var(--text);
  max-width: 500px;
  margin: 16px auto 0;
  font-size: 18px;
}

.input-section {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.repo-input {
  flex: 1;
  max-width: 400px;
  padding: 12px 16px;
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text-h);
  font-family: var(--mono);
  font-size: 16px;
}

.repo-input::placeholder {
  color: var(--text);
  opacity: 0.5;
}

.excavation-button {
  padding: 12px 24px;
  background: var(--accent);
  border: none;
  border-radius: 4px;
  color: var(--bg);
  font-weight: 500;
  cursor: pointer;
  transition: opacity 0.2s;
  font-size: 16px;
}

.excavation-button:hover {
  opacity: 0.9;
}

.excavation-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.excavation-button.loading {
  background: var(--accent);
  cursor: wait;
}

.error-message {
  color: var(--error);
  margin-top: 16px;
  font-size: 14px;
}

/* Dashboard */
.dashboard-container {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.sidebar {
  width: 240px;
  border-right: 1px solid var(--border);
  background: var(--bg);
  padding: 24px 0;
  overflow-y: auto;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 0 16px;
}

.nav-item {
  padding: 12px 16px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 500;
  color: var(--text);
  transition: background 0.2s;
}

.nav-item:hover {
  background: var(--accent-bg);
}

.nav-item.active {
  background: var(--accent-bg);
  color: var(--text-h);
  border-left: 3px solid var(--accent);
}

.nav-item .coming-soon {
  font-size: 12px;
  color: var(--text);
  margin-left: 8px;
  font-weight: normal;
}

.main-content {
  flex: 1;
  padding: 24px;
  overflow-y: auto;
}

.dashboard-header {
  text-align: center;
  border-bottom: 1px solid var(--border);
  padding-bottom: 16px;
  margin-bottom: 24px;
}

.dashboard-subtitle {
  color: var(--text);
  margin-top: 8px;
  font-size: 18px;
}

.summary-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.summary-card {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 16px;
  text-align: center;
}

.summary-card h3 {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 8px;
}

.summary-value {
  font-size: 28px;
  font-weight: 600;
  color: var(--text-h);
  font-family: var(--mono);
}

/* Main Finding */
.main-finding-card {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 24px;
  margin-bottom: 24px;
}

.main-finding-card h2 {
  color: var(--text-h);
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 22px;
}

.finding-title {
  font-size: 20px;
  font-weight: 600;
  color: var(--text-h);
  margin-bottom: 12px;
  font-family: var(--mono);
}

.finding-meta {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.badge {
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
}

.badge.severity-high {
  background: rgba(248,113,113,0.1);
  color: var(--error);
  border: 1px solid var(--error);
}

.badge.confidence-high {
  background: rgba(138,109,255,0.1);
  color: var(--accent);
  border: 1px solid var(--accent-border);
}

.finding-explanation {
  color: var(--text);
  line-height: 1.6;
  margin-bottom: 24px;
}

.evidence-chain {
  border-top: 1px solid var(--border);
  padding-top: 20px;
}

.evidence-chain h3 {
  margin-top: 0;
  margin-bottom: 16px;
  color: var(--text-h);
  font-size: 18px;
}

.evidence-link {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-bottom: 20px;
}

.evidence-type {
  flex: 0 0 80px;
  text-align: right;
  font-weight: 600;
  color: var(--accent);
  font-family: var(--mono);
  font-size: 14px;
  padding-top: 2px;
}

.evidence-arrow {
  align-self: flex-start;
  margin-top: 4px;
  color: var(--text);
  opacity: 0.5;
}

.evidence-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.evidence-file {
  color: var(--text);
  font-family: var(--mono);
  font-size: 14px;
}

.evidence-line {
  color: var(--text);
  opacity: 0.8;
  font-family: var(--mono);
  font-size: 14px;
}

.evidence-content {
  color: var(--text-h);
  font-family: var(--mono);
  font-size: 14px;
  line-height: 1.5;
}

.evidence-confidence {
  font-size: 12px;
  opacity: 0.8;
}

/* System Map */
.system-map-section {
  background: var(--code-bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 24px;
}

.system-map-section h2 {
  margin-top: 0;
  margin-bottom: 20px;
  color: var(--text-h);
  font-size: 22px;
}

.system-map-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}

.system-map-column h3 {
  margin-top: 0;
  margin-bottom: 12px;
  color: var(--text-h);
  font-size: 18px;
}

.system-map-item {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  padding: 12px;
}

.system-map-item div:first-child {
  font-weight: 600;
  color: var(--text-h);
  margin-bottom: 4px;
}

.system-map-detail {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 4px;
  font-family: var(--mono);
}

.confidence-badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 12px;
  background: var(--accent-bg);
  color: var(--accent);
  border: 1px solid var(--accent-border);
}